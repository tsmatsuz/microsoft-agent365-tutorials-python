USE_AGENTIC_AUTH=true
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTID={set-blueprint-app-id}
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTSECRET={set-blueprint-secret}
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__TENANTID={set-tenant-id}

AGENTAPPLICATION__USERAUTHORIZATION__HANDLERS__AGENTIC__SETTINGS__TYPE=AgenticUserAuthorization
AGENTAPPLICATION__USERAUTHORIZATION__HANDLERS__AGENTIC__SETTINGS__SCOPES=https://graph.microsoft.com/.default
AGENTAPPLICATION__USERAUTHORIZATION__HANDLERS__AGENTIC__SETTINGS__ALTERNATEBLUEPRINTCONNECTIONNAME=service_connection

CONNECTIONSMAP_0_SERVICEURL=*
CONNECTIONSMAP_0_CONNECTION=SERVICE_CONNECTION

# for Microsoft Agent Framework - Azure OpenAI
AZURE_OPENAI_ENDPOINT={set-azure-openai-endpoint}  # such as, https://{foundry-name}.services.ai.azure.com/
AZURE_OPENAI_API_KEY={set-azure-openai-apikey}
AZURE_OPENAI_MODEL={set-azure-openai-model-name}